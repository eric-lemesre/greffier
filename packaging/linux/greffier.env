# Réglages du service greffier (greffier.service), lus au démarrage.
# Ce fichier porte le jeton : il n'est lisible que par root et le groupe
# greffier (0640), et une mise à jour du paquet ne l'écrase jamais.

# Dossier du dépôt de savoir (un clone git, lisible par l'utilisateur
# greffier). Le service ne lit rien dans /home.
GREFFIER_SAVOIR=/var/lib/greffier/savoir

# Adresse d'écoute. Hors de la boucle locale, GREFFIER_JETON est exigé :
# sans lui, le serveur refuse de démarrer.
GREFFIER_ECOUTE=127.0.0.1:8370

# Jeton porteur exigé de tout client, sauf sur /sante.
#GREFFIER_JETON=

# Noms d'hôte sous lesquels le serveur est joint (derrière un mandataire
# inverse, par exemple), séparés par des virgules.
#GREFFIER_HOTES=greffier.exemple.fr
